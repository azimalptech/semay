rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStoreAdmin(storeId) {
      return isSignedIn()
        && request.auth.token.role == 'admin'
        && (storeId in request.auth.token.storeIds);
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStoreAdmin(storeId);
    }

    match /users/{uid}/avatar.jpg {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
