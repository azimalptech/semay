rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStoreAdmin(storeId) {
      return isSignedIn()
        && request.auth.token.role == 'admin'
        && (storeId in request.auth.token.storeIds);
    }

    // chatId is always '${uid}_${storeId}' (chat_service.dart's chatIdFor)
    // — Auth uids and Firestore auto-IDs are both alphanumeric, never
    // containing '_', so splitting on it reliably recovers both parts
    // without a Firestore lookup from within a Storage rule.
    function isChatParticipant(chatId) {
      return isSignedIn()
        && (request.auth.uid == chatId.split('_')[0]
          || isStoreAdmin(chatId.split('_')[1]));
    }

    function isValidMediaUpload() {
      return (request.resource.contentType.matches('video/.*')
                && request.resource.size < 100 * 1024 * 1024)
          || (request.resource.contentType.matches('image/.*')
                && request.resource.size < 10 * 1024 * 1024);
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow delete: if isStoreAdmin(storeId);
      allow create, update: if isStoreAdmin(storeId) && isValidMediaUpload();
    }

    match /users/{uid}/avatar.jpg {
      allow read: if true;
      // Unlike stores/** and chats/**, this had no size/type check at all —
      // any signed-in user could write an arbitrarily large blob of any
      // content type to their own avatar path.
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // chats/{chatId}/{file} — gallery photo/video attachments sent in a
    // chat thread. Chat IDs are deterministic ('${uid}_${storeId}', see
    // chat_service.dart), so "signed-in only" was an IDOR: any user could
    // construct any other user↔store chat ID and list/download its media.
    // The same determinism is what lets these rules identify the two
    // participants without a Firestore lookup: the segment before the
    // first '_' is the customer's uid, after it the storeId (Auth uids and
    // Firestore auto-IDs never contain '_').
    match /chats/{chatId}/{allPaths=**} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId) && isValidMediaUpload();
    }
  }
}
