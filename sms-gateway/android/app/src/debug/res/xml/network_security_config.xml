<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. Overrides the main source set's config so a debug APK can talk to
  a relay running on a development machine over plain HTTP on the LAN.

  This file is not part of a release build — `assembleRelease` uses
  src/main/res/xml/network_security_config.xml, which permits no cleartext at
  all. Do not "simplify" by moving this into main.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
