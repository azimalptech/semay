{
  "name": "semay-sms-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted SMS relay for SeMay OTP delivery — sms-gate.app-compatible API, WebSocket work channel to Android sender handsets.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "device:add": "node --env-file=.env scripts/add-device.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.3.0",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
