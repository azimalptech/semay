# Copy to `.env` and fill in. NEVER commit the real `.env`.

# ── Database ──────────────────────────────────────────────────────────────
# Separate database from the app's `semay`, same MySQL server. Create with:
#   CREATE DATABASE semay_sms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://semay:CHANGEME@localhost:3306/semay_sms?connection_limit=10&pool_timeout=20"

# ── HTTP server ───────────────────────────────────────────────────────────
# 8081 because the app API already owns 8080 on this box.
PORT=8081

# ── 3rd-party API auth (the SeMay API calls us with these) ────────────────
# HTTP Basic, matching sms-gate.app's contract so server/src/auth/sms.ts needs
# no code change. Generate the password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then set, in server/.env:
#   SMS_GATEWAY_URL="https://semaycollection.com/sms/3rdparty/v1"
#   SMS_GATEWAY_USER="<API_USER>"
#   SMS_GATEWAY_PASSWORD="<API_PASSWORD>"
API_USER="semay-api"
API_PASSWORD=""

# ── Dispatch ──────────────────────────────────────────────────────────────
# How long a message may sit Assigned to a handset before it is handed to a
# different SIM. Deliberately short: the server-side OTP is only valid for 5
# minutes, so a slow path is a failed login either way.
ASSIGN_TIMEOUT_SECONDS=45
# Reassignment cap before the message is Failed. An OTP arriving after its code
# expired is worse than one that never arrives — it just confuses the user.
MAX_ATTEMPTS=3

# ── Per-SIM throttling ────────────────────────────────────────────────────
# Consumer SIMs emitting application traffic get flagged and blocked by
# carriers, and a blocked SIM looks exactly like "login is broken" to users.
# These caps keep each SIM inside plausible volume. Tune only with evidence.
SIM_MAX_PER_HOUR=60
SIM_MAX_PER_DAY=300
# Minimum gap between two sends on the SAME SIM. Mirrors the 6s pacing the old
# Firebase-era queue used.
SIM_MIN_INTERVAL_MS=6000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
