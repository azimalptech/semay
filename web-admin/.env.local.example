# Copy to .env.local for local dev. These demo values only work against the
# local Firebase emulator suite (see backend/firebase.json) — same values as
# mobile/lib/core/firebase_options.dart's web config. Not secrets.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=demo-sender-id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-semay
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-semay.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-semay.appspot.com

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Server-only (Admin SDK) — never exposed to the browser.
GCLOUD_PROJECT=demo-semay
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
