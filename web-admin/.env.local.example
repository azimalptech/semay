# Copy to .env.local for local dev.

# Same MySQL database server/ uses — web-admin reads it directly via Prisma
# (Server Components + Route Handlers only; never exposed to the browser).
DATABASE_URL="mysql://semay:semay@localhost:3306/semay"

# Must match server/.env's JWT_SECRET exactly — this app verifies the same
# access tokens server/ issues, it doesn't mint its own.
JWT_SECRET="REPLACE_WITH_SAME_VALUE_AS_SERVER_ENV"

# The new REST API — used for mutations that need server/'s transactional
# side effects (claims_version bumps, real FCM sends): store create/delete,
# store-admin grant/revoke, broadcast, notification-request decisions.
API_BASE_URL="http://localhost:8080/api/v1"

# Local public media folder — the leaderboard gift-image upload writes straight
# into the SAME folder server/ serves (no MinIO). MEDIA_DIR must resolve to the
# same directory as server/'s MEDIA_DIR (../server/media = server/'s ./media in
# this layout); MEDIA_PUBLIC_BASE_URL must match server/.env's.
MEDIA_DIR="../server/media"
MEDIA_PUBLIC_BASE_URL="http://localhost:8080/media"
