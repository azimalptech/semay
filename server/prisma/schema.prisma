// SeMay self-hosted backend — MySQL schema (Phase 1 of the Firebase → MySQL
// migration; see docs/07_MIGRATION.md and .claude/plans). Faithful relational
// translation of docs/02_DATA_MODEL.md. Field-level rationale lives there; this
// file only notes where the relational shape deliberately DIFFERS from the old
// Firestore doc shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  superadmin
}

enum Language {
  tk
  ru
}

enum PostType {
  image
  carousel
  reel
}

enum StoryMediaType {
  image
  video
}

enum SenderRole {
  user
  admin
}

enum MessageMediaType {
  image
  video
}

enum OrderStatus {
  accepted
}

enum NotificationRequestStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) // random UUID — NOT sha256(phone); the phone UNIQUE index below is the 1-phone-1-account lock (replaces verifyOtp's deterministic-uid trick)
  phone     String   @unique @db.VarChar(20)
  name      String   @default("") @db.VarChar(120)
  avatarUrl String   @default("") @db.VarChar(512)
  role      Role     @default(user)
  language  Language @default(tk)
  darkMode  Boolean  @default(false)

  // Password login for the Super Admin web panel ONLY, at the owner's explicit
  // request (2026-07-30) — a deliberate deviation from Phase 8's original
  // decision to give superadmin the same OTP flow as everyone else (see
  // docs/07_MIGRATION.md). Null for every regular/store-admin user; the mobile
  // app never reads or sets this column. bcrypt hash, never plaintext — see
  // auth/superadminAuth.ts.
  passwordHash String? @db.VarChar(255)

  // Transient "which chat is open on this device" pointer (onMessageCreated
  // reads it to suppress a redundant push). Plain nullable id, no FK relation —
  // it's cleared on dispose and a dangling value is harmless.
  activeChatId String? @db.VarChar(80)

  // Bumped whenever role/storeIds change (setStoreAdmin/deleteStore); embedded
  // in the access JWT so a stale token triggers a silent refresh. Replaces the
  // app's hand-built _syncedIdTokenResultProvider claim-drift polling.
  claimsVersion Int @default(0)

  createdAt DateTime @default(now())

  // Set by deleteAccount (users/service.ts). The row is NOT removed: orders
  // reference it and stores must keep accurate sales history, so the account is
  // anonymized in place instead — phone/name/avatar scrubbed, personal data
  // (chats, likes, notifications, sessions, tokens) hard-deleted. A tombstoned
  // row can never be signed into: its phone is rewritten to a `del_…` sentinel,
  // which frees the real number for a genuine fresh signup.
  deletedAt DateTime?

  storeAdminRoles      StoreAdmin[]
  storesCreated        Store[]               @relation("StoreCreatedBy")
  posts                PostLike[]
  saves                PostSave[]
  views                PostView[]
  sent                 PostSent[]
  shares               PostShare[]
  storyViews           StoryView[]
  storySeen            UserStorySeen[]
  chats                Chat[]
  messagesSent         Message[]
  ordersPlaced         Order[]               @relation("OrderUser")
  ordersAccepted       Order[]               @relation("OrderAdmin")
  leaderboardEntries   StoreLeaderboard[]
  notifications        UserNotification[]
  notificationRequests NotificationRequest[]
  sessions             Session[]
  fcmTokens            UserFcmToken[]

  @@map("users")
}

// One row per store↔admin link. Replaces BOTH stores.adminIds and
// users.storeIds arrays (the old dual-write drift bug is gone). role stays on
// User; the last row removed for a user demotes them to 'user' in the same tx.
model StoreAdmin {
  storeId   String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  grantedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_admins")
}

// Opaque refresh session (hashed). Fast path = short-lived access JWT verified
// locally; slow path = this table looked up per sensitive route (checkRevoked).
model Session {
  id         String    @id @default(uuid())
  userId     String    @db.VarChar(36)
  tokenHash  String    @unique @db.VarChar(64) // sha256 hex of the opaque refresh token
  deviceInfo String?   @db.VarChar(255)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// FCM stays on Firebase; only the token registry moves here. UNIQUE(token) +
// upsert-on-conflict fixes the reinstall/relogin ownership ambiguity arrayUnion had.
model UserFcmToken {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  platform  String?  @db.VarChar(20)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_fcm_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stores
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(120)
  tagline          String    @default("") @db.VarChar(255)
  avatarUrl        String    @default("") @db.VarChar(512)
  coverUrl         String    @default("") @db.VarChar(512)
  phone            String    @default("") @db.VarChar(20)
  address          String    @default("") @db.VarChar(255)
  geoLat           Decimal?  @db.Decimal(9, 6)
  geoLng           Decimal?  @db.Decimal(9, 6)
  postsCount       Int       @default(0)
  reelsCount       Int       @default(0)
  // Total likes across this store's posts — the "Halananlar" stat on the store
  // detail header. Denormalized for the same reason postsCount/reelsCount are:
  // the header is read constantly and a SUM over every post of the store on each
  // load would scale with catalogue size. Maintained in the same transaction as
  // the per-post like toggle (posts/service.ts setToggle), so it can't drift.
  // Deliberately NOT backfilled from existing likes (owner's call) — it starts at
  // 0 and counts from the migration forward.
  likesCount       Int       @default(0)
  createdById      String    @db.VarChar(36)
  active           Boolean   @default(true)
  leaderboardOrder Int?
  campaignImageUrl String?   @db.VarChar(512)
  campaignStartAt  DateTime?
  campaignEndAt    DateTime?
  createdAt        DateTime  @default(now())

  createdBy            User                  @relation("StoreCreatedBy", fields: [createdById], references: [id])
  admins               StoreAdmin[]
  posts                Post[]
  stories              Story[]
  chats                Chat[]
  orders               Order[]
  leaderboard          StoreLeaderboard[]
  quickReplies         StoreQuickReply[]
  notificationRequests NotificationRequest[]

  @@index([active])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// Posts
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id           String   @id @default(uuid())
  storeId      String   @db.VarChar(36)
  type         PostType
  caption      String   @db.Text // MySQL forbids a DEFAULT on TEXT — API must always pass "" explicitly, not omit
  price        Decimal? @db.Decimal(10, 2) // SQL forces the currency-precision decision Firestore let us skip
  thumbnailUrl String   @default("") @db.VarChar(512) // reels
  likesCount   Int      @default(0)
  savesCount   Int      @default(0)
  viewsCount   Int      @default(0)
  sentCount    Int      @default(0)
  sharesCount  Int      @default(0)
  createdAt    DateTime @default(now())

  store  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  media  PostMedia[]
  likes  PostLike[]
  saves  PostSave[]
  views  PostView[]
  sent   PostSent[]
  shares PostShare[]

  @@index([storeId, createdAt])
  @@index([type, createdAt]) // a store's posts filtered by type; /reels (single type)
  // The global /feed — the app's home screen and hottest query — filters
  // `type IN ('image','carousel')` and orders by createdAt. The composite index
  // above CANNOT serve that: it orders by createdAt only *within* one type, so
  // spanning two types made MariaDB abandon the index entirely and fall back to
  // a full table scan plus a filesort of every matching row. Measured on 300k
  // posts: 135ms and growing linearly, vs 0.2ms with this index (it walks
  // createdAt DESC and filters out reels as it goes, touching ~30 rows to
  // return 20). Posts are read constantly and written rarely, so the extra
  // write cost is the right trade.
  @@index([createdAt])
  @@map("posts")
}

// Replaces mediaUrls[] — real ordering column, real child rows (a failed
// mid-upload create now leaves deletable orphan rows, unlike an array-in-doc).
model PostMedia {
  id           BigInt  @id @default(autoincrement())
  postId       String  @db.VarChar(36)
  url          String  @db.VarChar(512)
  position     Int
  thumbnailUrl String? @db.VarChar(512)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_media")
}

// Each of the five below replaces an existence-checked subcollection AND its
// denormalized count driver. users/{uid}/liked and /saved are NOT reproduced —
// INDEX(userId, createdAt) here serves "My Liked/Saved" directly.
model PostLike {
  postId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model PostSave {
  postId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_saves")
}

model PostView {
  postId   String   @db.VarChar(36)
  userId   String   @db.VarChar(36)
  viewedAt DateTime @default(now())
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_views")
}

model PostSent {
  postId String   @db.VarChar(36)
  userId String   @db.VarChar(36)
  sentAt DateTime @default(now())
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_sent")
}

model PostShare {
  postId   String   @db.VarChar(36)
  userId   String   @db.VarChar(36)
  sharedAt DateTime @default(now())
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_shares")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stories
// ─────────────────────────────────────────────────────────────────────────────

model Story {
  id        String         @id @default(uuid())
  storeId   String         @db.VarChar(36)
  mediaUrl  String         @db.VarChar(512)
  mediaType StoryMediaType
  createdAt DateTime       @default(now())
  expiresAt DateTime // createdAt + 24h

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([storeId, createdAt])
  @@index([expiresAt]) // active-stories query + expireStories sweep
  @@map("stories")
}

model StoryView {
  storyId  String   @db.VarChar(36)
  userId   String   @db.VarChar(36)
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@map("story_views")
}

// Replaces users/{uid}/storySeen/{storeId}.
model UserStorySeen {
  userId  String   @db.VarChar(36)
  storeId String   @db.VarChar(36)
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_story_seen")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────────────────────

// Deterministic PK ${userId}_${storeId} kept — createOrGetChat becomes an
// INSERT IGNORE in a synchronous tx, so the old !hasPendingWrites race
// workaround is structurally impossible (MySQL has no client write-cache).
model Chat {
  id              String    @id @db.VarChar(80)
  userId          String    @db.VarChar(36)
  storeId         String    @db.VarChar(36)
  lastMessageText String?   @db.VarChar(512)
  lastMessageAt   DateTime?
  unreadByUser    Int       @default(0)
  unreadByAdmin   Int       @default(0)
  typingUserAt    DateTime?
  typingAdminAt   DateTime?
  hiddenByUserAt  DateTime?
  hiddenByAdminAt DateTime?
  mutedByUser     Boolean   @default(false)
  mutedByAdmin    Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@index([storeId, unreadByAdmin]) // admin unread-badge query
  @@map("chats")
}

model Message {
  id                BigInt            @id @default(autoincrement()) // monotonic ordering = old limitToLast(200)
  chatId            String            @db.VarChar(80)
  senderId          String            @db.VarChar(36)
  senderRole        SenderRole
  text              String            @db.Text // MySQL forbids a DEFAULT on TEXT — API must always pass "" explicitly, not omit
  mediaUrl          String?           @db.VarChar(512)
  mediaType         MessageMediaType?
  orderId           String?           @db.VarChar(36)
  sharedPostId      String?           @db.VarChar(36)
  sharedStoryId     String?           @db.VarChar(36)
  replyToMessageId  BigInt?
  replyToText       String?           @db.VarChar(512)
  replyToSenderRole SenderRole?
  // Client-generated idempotency key (offline outbox, Phase 9b) — a retried
  // send under flaky signal reuses the same key, so the second insert is a
  // no-op that returns the already-created row instead of a dupe.
  //
  // Scoped to the chat, NOT globally unique. A global UNIQUE made the key a
  // cross-chat handle: sendMessage looked it up with findUnique and returned
  // whatever row owned it, so replaying a key read back a stranger's private
  // message — text, sender and timestamps — from a chat the caller gets 403 on.
  // Orders mint structurally derivable keys (`order:{id}`), so the keyspace was
  // partly guessable rather than purely random. Per-chat uniqueness is what the
  // idempotency actually needs: a genuine retry always targets the same chat.
  clientKey         String?           @db.VarChar(64)
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  deliveredAt       DateTime?         @db.DateTime(3)
  readAt            DateTime?         @db.DateTime(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([chatId, clientKey])
  @@index([chatId, id])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & leaderboard
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(uuid())
  storeId      String      @db.VarChar(36)
  adminId      String      @db.VarChar(36)
  userId       String      @db.VarChar(36)
  chatId       String      @db.VarChar(80)
  itemQuantity Int
  userPhone    String      @db.VarChar(20)
  status       OrderStatus @default(accepted)
  // Client-generated idempotency key, same mechanism messages already use.
  // Accepting an order is a real sale that also increments the prize
  // leaderboard, and it had NO dedup: if the request succeeded but the response
  // was lost (flaky mobile network), the admin's natural retry created a second
  // order and double-counted the customer's standings. The client sends one key
  // per accept-sheet session, so a retry collapses onto the first order while a
  // deliberately re-opened sheet still creates a genuine second one.
  clientKey    String?     @unique @db.VarChar(64)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation("OrderUser", fields: [userId], references: [id])
  admin User  @relation("OrderAdmin", fields: [adminId], references: [id])

  @@index([storeId, createdAt])
  @@map("orders")
}

// Denormalized per-store per-user order-quantity aggregate (public read).
model StoreLeaderboard {
  storeId   String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  userName  String   @db.VarChar(120)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([storeId, quantity]) // orderBy quantity desc limit 20
  @@map("store_leaderboard")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications, quick replies, requests
// ─────────────────────────────────────────────────────────────────────────────

model UserNotification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @db.VarChar(36)
  title     String    @db.VarChar(255)
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime? // null = unread (richer than the old boolean `read`)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_notifications")
}

model StoreQuickReply {
  id        BigInt   @id @default(autoincrement())
  storeId   String   @db.VarChar(36)
  text      String   @db.VarChar(512)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, position])
  @@map("store_quick_replies")
}

model NotificationRequest {
  id          String                    @id @default(uuid())
  storeId     String                    @db.VarChar(36)
  storeName   String                    @db.VarChar(120)
  requestedBy String                    @db.VarChar(36)
  message     String                    @db.VarChar(500)
  status      NotificationRequestStatus @default(pending)
  createdAt   DateTime                  @default(now())
  decidedAt   DateTime?
  decidedBy   String?                   @db.VarChar(36)

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requestedBy], references: [id])

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@map("notification_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP & SMS pacing (never exposed via any route)
// ─────────────────────────────────────────────────────────────────────────────

model OtpCode {
  phone       String    @id @db.VarChar(20)
  code        String    @db.VarChar(6)
  expiresAt   DateTime
  lastSentAt  DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?

  @@map("otp_codes")
}

// sms_dispatch_queue / sms_dispatch_cursor were removed here: they existed for
// Firebase-era bulk SMS pacing that this codebase no longer does. OTP is the only
// SMS this system sends, one message at a time, straight through the gateway
// (auth/sms.ts) — nothing ever read or wrote these tables.

// Distributed lease so exactly one process runs a scheduled job at a time, across
// every worker AND every machine (see maintenance.ts).
//
// Deliberately NOT MySQL's GET_LOCK: that lock belongs to the *session*, while
// Prisma hands each query an arbitrary pooled connection — so RELEASE_LOCK
// usually runs on a different connection than GET_LOCK, silently fails, and the
// lock stays held by a pooled connection that never closes. The job would then
// run once and never again. A row with an expiry is connection-agnostic and
// self-healing: a holder that crashes mid-run just lets the lease lapse.
model MaintenanceLease {
  name        String   @id @db.VarChar(64)
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt

  @@map("maintenance_leases")
}
