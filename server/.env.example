# Copy to `.env` and fill in. NEVER commit the real `.env`.

# ── Database ──────────────────────────────────────────────────────────────
# MySQL 8. On the Turkmenistan server this points at localhost; for local dev,
# a local MySQL or a docker container. At scale, size the Prisma connection pool
# for the box with ?connection_limit=N (default is num_cpus*2+1, often too small
# under load) and keep it well under MySQL's max_connections — e.g.
# ...localhost:3306/semay?connection_limit=20&pool_timeout=20
DATABASE_URL="mysql://semay:changeme@localhost:3306/semay"

# ── HTTP server ───────────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed origins for the web-admin (CORS). The mobile app is
# not origin-bound.
WEB_ADMIN_ORIGIN="http://localhost:3000"
# Per-IP request cap (backstop against a runaway/abusive client). Kept generous
# because carrier NAT can put many real users behind one IP — real abuse of the
# login path is bounded separately by the per-phone OTP cooldown/lockout below.
RATE_LIMIT_MAX_PER_MIN=3000
RATE_LIMIT_AUTH_MAX_PER_MIN=60

# ── Auth ──────────────────────────────────────────────────────────────────
# HMAC secret for signing short-lived access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_ME_LONG_RANDOM_SECRET"
ACCESS_TOKEN_TTL_SECONDS=900          # 15 min
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP / SMS gateway (capcom6 / sms-gate.app) ──────────────────────────────
# Base URL that exposes POST /message with HTTP Basic auth. Set to whichever
# gateway mode you run:
#   Local Server (phone on the LAN):  http://<phone-ip>:8080
#   Cloud "Connect" relay:            https://api.sms-gate.app/3rdparty/v1
#   Self-hosted relay:                https://<your-relay>/api/3rdparty/v1
# Required when OTP_DEV_MODE=false (the server refuses to boot otherwise).
SMS_GATEWAY_URL=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASSWORD=""
# One global send every N ms (carrier throttling) — matches the old 6s pacing.
SMS_SEND_INTERVAL_MS=6000
OTP_TTL_SECONDS=300                    # 5 min
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
# When true (local dev), verify responses echo the code and no real SMS is sent.
OTP_DEV_MODE=true

# ── FCM (stays on Firebase — push only) ────────────────────────────────────
# Path to the Firebase service-account JSON used by the Admin SDK messaging
# client. This is the ONLY remaining Firebase dependency.
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
FIREBASE_PROJECT_ID="semay-b57ee"

# ── Media storage (local public folder) ───────────────────────────────────
# MEDIA_DIR: on-disk folder where uploads are written (relative to server/).
# MEDIA_PUBLIC_BASE_URL: where they're served from. The API serves /media
# itself, so this is normally <api-origin>/media (dev: http://localhost:8080/media,
# prod: https://api.<domain>/media, or a Caddy/Nginx file_server host you point
# at MEDIA_DIR). Its origin is also where signed upload PUTs are sent.
MEDIA_DIR="./media"
MEDIA_PUBLIC_BASE_URL="http://localhost:8080/media"
