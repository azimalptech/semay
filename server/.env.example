# Copy to `.env` and fill in. NEVER commit the real `.env`.

# ── Database ──────────────────────────────────────────────────────────────
# MySQL 8. On the Turkmenistan server this points at localhost; for local dev,
# a local MySQL or a docker container. At scale, size the Prisma connection pool
# for the box with ?connection_limit=N (default is num_cpus*2+1, often too small
# under load) and keep it well under MySQL's max_connections — e.g.
# ...localhost:3306/semay?connection_limit=20&pool_timeout=20
#
# CAPACITY MATH (read before scaling up — this is what breaks first):
#   total MySQL connections used = CLUSTER_WORKERS x connection_limit
# That product must stay comfortably under MySQL's max_connections (default 151).
# Example for an 8-core box: 8 workers x 15 = 120 connections, which fits. Raising
# connection_limit without checking this is how you get
# "Too many connections" under load while the app looks idle.
DATABASE_URL="mysql://semay:changeme@localhost:3306/semay?connection_limit=15&pool_timeout=20"

# ── HTTP server ───────────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed origins for the web-admin (CORS). The mobile app is
# not origin-bound.
WEB_ADMIN_ORIGIN="http://localhost:3000"
# Per-IP request cap (backstop against a runaway/abusive client). Kept generous
# because carrier NAT can put many real users behind one IP — real abuse of the
# login path is bounded separately by the per-phone OTP cooldown/lockout below.
RATE_LIMIT_MAX_PER_MIN=3000
RATE_LIMIT_AUTH_MAX_PER_MIN=60
# Separate, wider cap for /auth/refresh and /auth/logout: a refresh token is not
# guessable and costs no SMS, and one NAT'd cell — or the admin panel's single
# server IP — renews far more often than anyone requests OTPs.
RATE_LIMIT_REFRESH_MAX_PER_MIN=600

# ── Auth ──────────────────────────────────────────────────────────────────
# HMAC secret for signing short-lived access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_ME_LONG_RANDOM_SECRET"
ACCESS_TOKEN_TTL_SECONDS=900          # 15 min
# Sessions last until logout. A refresh token only expires after this many days
# WITHOUT use — every refresh re-issues it with a fresh window — so this bounds
# abandoned devices, not how often anyone logs in. 730 = 2 years.
REFRESH_TOKEN_TTL_DAYS=730
# A refresh token that was rotated away this recently is still accepted (the
# caller gets its own live successor): covers a lost refresh response and two
# browser tabs racing on one cookie. Outside the window a replay gets 401.
REFRESH_REUSE_GRACE_SECONDS=60

# ── OTP / SMS gateway (our own relay — sms-gateway/) ────────────────────────
# Base URL exposing POST /message with HTTP Basic auth. This points at the
# relay in `sms-gateway/`, fronted by nginx (see sms-gateway/deploy/):
#   https://semaycollection.com/sms/3rdparty/v1
# Locally, the relay direct:
#   http://127.0.0.1:8081/3rdparty/v1
#
# WHY OUR OWN RELAY, not capcom6 / api.sms-gate.app, which this used to be:
# that host is unreachable from Turkmen networks. Measured from the gateway
# handset, same Wi-Fi, same moment: 100% packet loss to api.sms-gate.app while
# semaycollection.com answered in 13ms and google.com/fcm.googleapis.com were
# fine. So it is that domain being filtered, not general censorship, and no
# amount of reconfiguring fixed it — messages simply sat at Pending forever.
#
# The protocol is unchanged (sms.ts needed no edit), so pointing this back at
# any sms-gate.app-compatible gateway still works if you ever want to.
#
# USER/PASSWORD are API_USER / API_PASSWORD from sms-gateway/.env — they
# authenticate this API to the relay, and are unrelated to device tokens.
# Required when OTP_DEV_MODE=false (the server refuses to boot otherwise).
SMS_GATEWAY_URL=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASSWORD=""
# One global send every N ms (carrier throttling) — matches the old 6s pacing.
SMS_SEND_INTERVAL_MS=6000
OTP_TTL_SECONDS=300                    # 5 min
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
# When true (local dev), verify responses echo the code and no real SMS is sent.
OTP_DEV_MODE=true

# ── Demo account (app-store review) ────────────────────────────────────────
# ONE phone number that logs in with a FIXED code instead of a real SMS, for
# reviewers who cannot receive an SMS on a Turkmen number. Both empty (the
# default) disables it entirely.
#
# This is a deliberate authentication bypass with a permanent, published
# credential, so it is deliberately narrow:
#   - exactly one number, exactly one code;
#   - the code must be 6 digits or the verify route would reject it anyway;
#   - it REFUSES to authenticate unless the account's role is plain "user".
#     That last rule is the important one — without it, promoting this number
#     in the admin panel would silently hand the published code real
#     privileges, and nothing would look wrong until it was being used.
# A refusal returns 403 TEST_PHONE_NOT_PERMITTED and logs at error level.
OTP_TEST_PHONE="+99363538839"
OTP_TEST_CODE="123456"

# ── FCM (stays on Firebase — push only) ────────────────────────────────────
# Path to the Firebase service-account JSON used by the Admin SDK messaging
# client. This is the ONLY remaining Firebase dependency. Generate it in the
# console for project semay-b57ee: Project settings → Service accounts →
# "Generate new private key" (the account is
# firebase-adminsdk-fbsvc@semay-b57ee.iam.gserviceaccount.com), and save the
# download as server/serviceAccount.json — git-ignored, never committed. The
# Admin SDK sends over the FCM HTTP v1 API, so the deprecated legacy server key
# stays disabled in the project. At boot the key's project_id is checked
# against FIREBASE_PROJECT_ID: a mismatch (or an app/web config saved under this
# name) disables push with the reason in the log instead of failing every send
# later. Full steps: docs/09_DEPLOYMENT.md §5d.
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
FIREBASE_PROJECT_ID="semay-b57ee"

# ── Media storage (local public folder) ───────────────────────────────────
# MEDIA_DIR: on-disk folder where uploads are written (relative to server/).
# MEDIA_PUBLIC_BASE_URL: where they're served from. The API serves /media
# itself, so this is normally <api-origin>/media (dev: http://localhost:8080/media,
# prod: https://api.<domain>/media, or a Caddy/Nginx file_server host you point
# at MEDIA_DIR). Its origin is also where signed upload PUTs are sent.
MEDIA_DIR="./media"
# MUST be https for any real host — the signed media UPLOAD origin is derived
# from this value, so http behind TLS makes every post publish fail on a 301
# the mobile client will not follow. config.ts refuses to boot on it.
# Loopback is exempt (local dev has no certificate).
MEDIA_PUBLIC_BASE_URL="http://localhost:8080/media"

# ── Public share pages (/p/<id>, /r/<id>, /s/<id>) ────────────────────────
# The only unauthenticated HTML this API serves. A share button in the app
# produces https://<origin>/p/<postId>; whoever receives it may have no app,
# so these five routes render a small page with an "Open in SeMay" button and
# the store links. docs/08_OPERATIONS.md §6f, docs/09_DEPLOYMENT.md §5e.
#
# "generic" is the only supported value and is a security property, not a
# placeholder: the page is byte-identical for every id, so it performs NO
# database read and cannot be used to probe which posts or stores exist.
SHARE_PAGE_MODE=generic
# Origin the page advertises as its own (canonical link, og:url, the Android
# intent fallback). Empty = derive it from MEDIA_PUBLIC_BASE_URL's origin,
# which is already the API's public origin — leave it empty unless the share
# links live on a different host from the API.
SHARE_PUBLIC_BASE_URL=""
# Per-IP cap for the share surface. Deliberately far below the global limit:
# a real recipient loads one page once, and these are the only routes a
# stranger holding a link can reach at all.
RATE_LIMIT_SHARE_MAX_PER_MIN=120
# Where a recipient WITHOUT the app is sent: the two store buttons, and — for
# SHARE_PLAY_URL — the Android "Open in SeMay" button's fallback when Chrome
# cannot find the package. Both default to empty, which renders a "coming
# soon" badge instead of a link; fill each one in only once THAT listing is
# actually published, or recipients get a store 404 instead of an honest
# "Ýakynda". Typical values:
#   SHARE_PLAY_URL="https://play.google.com/store/apps/details?id=com.semay.semay"
#   SHARE_APPSTORE_URL="https://apps.apple.com/app/id<numeric id>"
SHARE_PLAY_URL=""
SHARE_APPSTORE_URL=""
# Android App Links. SHA-256 fingerprint(s) of the certificate the INSTALLED
# app is signed with, comma-separated, colon-separated uppercase hex as
# keytool prints them. With Play App Signing this is the certificate Play
# shows under "App signing key certificate" — NOT the upload key; using the
# upload key makes `adb shell pm get-app-links com.semay.semay` report "none"
# forever with no other symptom. Empty serves a valid but empty assetlinks
# document, so verification simply cannot succeed yet.
SHARE_ANDROID_CERT_SHA256=""
# iOS Universal Links: "<TEAM ID>.<bundle id>", e.g. ABCDE12345.com.semay.semay.
# Empty makes /.well-known/apple-app-site-association answer 404 — correct
# while the app ships without the associated-domains entitlement (Apple
# Developer portal work; the share page's own button opens the app meanwhile).
# NOT an empty document: Apple caches this file in its own CDN, and a cached
# "delegates nothing" would outlive the day the entitlement lands.
SHARE_IOS_APP_ID=""
# The Android package the page's intent:// button targets. Only changes if
# the app's applicationId does.
SHARE_ANDROID_PACKAGE="com.semay.semay"

# ── Scaling ───────────────────────────────────────────────────────────────
# Cross-process pub-sub for the realtime WebSocket gateway.
#   Empty  = in-process only. Correct and fastest for ONE server process.
#   Set    = REQUIRED the moment you run more than one process (cluster mode,
#            multiple containers, or two machines). Without it a message
#            published on one process never reaches sockets on another, so users
#            silently miss realtime updates.
REDIS_URL=""
# Set but unreachable is NOT silent: the process boots delivering in-process
# only, logs an error line naming the host, and /health/ready reports
# bus.ready=false + degraded=true. Cluster mode refuses to fork instead.
# REDIS_REQUIRED=true makes a box stop serving REALTIME after 30 s without the
# bus (implied for cluster workers): the gateway refuses new subscribes and
# closes the sockets it is holding, so phones reconnect somewhere that works,
# and GET /health/realtime answers 503 for the WebSocket upstream's health
# check. /health/ready keeps answering 200 on purpose — login, feed, stores,
# orders and media do not need Redis, and every box sharing one Redis crosses
# that threshold at the same instant, so failing readiness would leave the load
# balancer with no backend at all. Set it when several single-process machines
# share one Redis.
REDIS_REQUIRED=false
# Worker processes for `npm run start:cluster`. 0 = one per CPU core.
# A single Node process only ever uses one core — clustering is what turns an
# 8-core server into 8x the request throughput. Requires REDIS_URL (see above).
CLUSTER_WORKERS=0

# ── Logging ───────────────────────────────────────────────────────────────
# Request/error logs are written as newline-delimited JSON to
# LOG_DIR/app.<date>.log, rotated daily, keeping LOG_RETENTION_DAYS files.
# Outside production they are also pretty-printed to the console.
LOG_DIR="./logs"
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
