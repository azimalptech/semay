# Copy to `.env` and fill in. NEVER commit the real `.env`.

# ── Database ──────────────────────────────────────────────────────────────
# MySQL 8. On the Turkmenistan server this points at localhost; for local dev,
# a local MySQL or a docker container. At scale, size the Prisma connection pool
# for the box with ?connection_limit=N (default is num_cpus*2+1, often too small
# under load) and keep it well under MySQL's max_connections — e.g.
# ...localhost:3306/semay?connection_limit=20&pool_timeout=20
#
# CAPACITY MATH (read before scaling up — this is what breaks first):
#   total MySQL connections used = CLUSTER_WORKERS x connection_limit
# That product must stay comfortably under MySQL's max_connections (default 151).
# Example for an 8-core box: 8 workers x 15 = 120 connections, which fits. Raising
# connection_limit without checking this is how you get
# "Too many connections" under load while the app looks idle.
DATABASE_URL="mysql://semay:changeme@localhost:3306/semay?connection_limit=15&pool_timeout=20"

# ── HTTP server ───────────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed origins for the web-admin (CORS). The mobile app is
# not origin-bound.
WEB_ADMIN_ORIGIN="http://localhost:3000"
# Per-IP request cap (backstop against a runaway/abusive client). Kept generous
# because carrier NAT can put many real users behind one IP — real abuse of the
# login path is bounded separately by the per-phone OTP cooldown/lockout below.
RATE_LIMIT_MAX_PER_MIN=3000
RATE_LIMIT_AUTH_MAX_PER_MIN=60

# ── Auth ──────────────────────────────────────────────────────────────────
# HMAC secret for signing short-lived access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_ME_LONG_RANDOM_SECRET"
ACCESS_TOKEN_TTL_SECONDS=900          # 15 min
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP / SMS gateway (capcom6 / sms-gate.app) ──────────────────────────────
# Base URL that exposes POST /message with HTTP Basic auth. Set to whichever
# gateway mode you run:
#   Local Server (phone on the LAN):  http://<phone-ip>:8090
#   Cloud "Connect" relay:            https://api.sms-gate.app/3rdparty/v1
#   Self-hosted relay:                https://<your-relay>/api/3rdparty/v1
#
# PICK BY WHERE THE API RUNS — this is a reachability constraint, not taste:
#   API on the same LAN as the phone  → Local Server works (lowest latency, no
#                                       third party sees your OTP text).
#   API on a remote/hosted box        → Local Server CANNOT work. The phone's
#                                       address is a private RFC1918 IP behind
#                                       NAT; a remote server has no route to it,
#                                       and no static DHCP reservation changes
#                                       that. Use the Cloud relay: the phone
#                                       holds an OUTBOUND connection to
#                                       api.sms-gate.app, so nothing inbound to
#                                       the phone is required.
# Cloud and Local have SEPARATE credentials — the Cloud username/password shown
# in the app's "Cloud server" card are not the Local Server ones.
# Required when OTP_DEV_MODE=false (the server refuses to boot otherwise).
SMS_GATEWAY_URL=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASSWORD=""
# One global send every N ms (carrier throttling) — matches the old 6s pacing.
SMS_SEND_INTERVAL_MS=6000
OTP_TTL_SECONDS=300                    # 5 min
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
# When true (local dev), verify responses echo the code and no real SMS is sent.
OTP_DEV_MODE=true

# ── FCM (stays on Firebase — push only) ────────────────────────────────────
# Path to the Firebase service-account JSON used by the Admin SDK messaging
# client. This is the ONLY remaining Firebase dependency.
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
FIREBASE_PROJECT_ID="semay-b57ee"

# ── Media storage (local public folder) ───────────────────────────────────
# MEDIA_DIR: on-disk folder where uploads are written (relative to server/).
# MEDIA_PUBLIC_BASE_URL: where they're served from. The API serves /media
# itself, so this is normally <api-origin>/media (dev: http://localhost:8080/media,
# prod: https://api.<domain>/media, or a Caddy/Nginx file_server host you point
# at MEDIA_DIR). Its origin is also where signed upload PUTs are sent.
MEDIA_DIR="./media"
MEDIA_PUBLIC_BASE_URL="http://localhost:8080/media"

# ── Scaling ───────────────────────────────────────────────────────────────
# Cross-process pub-sub for the realtime WebSocket gateway.
#   Empty  = in-process only. Correct and fastest for ONE server process.
#   Set    = REQUIRED the moment you run more than one process (cluster mode,
#            multiple containers, or two machines). Without it a message
#            published on one process never reaches sockets on another, so users
#            silently miss realtime updates.
REDIS_URL=""
# Worker processes for `npm run start:cluster`. 0 = one per CPU core.
# A single Node process only ever uses one core — clustering is what turns an
# 8-core server into 8x the request throughput. Requires REDIS_URL (see above).
CLUSTER_WORKERS=0

# ── Logging ───────────────────────────────────────────────────────────────
# Request/error logs are written as newline-delimited JSON to
# LOG_DIR/app.<date>.log, rotated daily, keeping LOG_RETENTION_DAYS files.
# Outside production they are also pretty-printed to the console.
LOG_DIR="./logs"
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
