{
  "name": "semay-server",
  "version": "0.1.0",
  "private": true,
  "description": "SeMay self-hosted API server (Fastify + ws + Prisma/MySQL) — replaces Firebase backend, keeps FCM for push only.",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "start:cluster": "node --env-file=.env dist/cluster.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pino-roll": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
