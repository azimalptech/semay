# Dependencies
node_modules/

# Build output
dist/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
serviceAccount*.json
*-service-account.json

# Prisma
prisma/*.db
prisma/*.db-journal

# Media — user uploads are runtime data, never committed.
# Leading slash matters: an unanchored `media/` matches a directory of that name
# at ANY depth, which silently swallowed src/media/ (routes.ts + storage.ts —
# the signed-upload endpoint and the disk-storage layer). Already-tracked files
# ignore .gitignore, so this stayed invisible until a fresh clone-and-recommit
# dropped both source files without a word.
/media/

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# node-windows service wrapper (generated by scripts/service.mjs) — the
# wrapper .exe and its logs are machine-local build output, never source.
daemon/
_audit_fixtures.mjs
