# Dependencies
node_modules/

# Build output
dist/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
serviceAccount*.json
*-service-account.json

# Prisma
prisma/*.db
prisma/*.db-journal

# Media — user uploads are runtime data, never committed
media/

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# node-windows service wrapper (generated by scripts/service.mjs) — the
# wrapper .exe and its logs are machine-local build output, never source.
daemon/
