<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- iOS TERMINATES the process when a restricted resource is touched with no
	     usage string present — this is not a review-only requirement, the app
	     crashes on device. All three are reached from normal flows:
	       camera      add_story_flow.dart (photo + pickVideo from camera)
	       microphone  the same pickVideo — recording captures audio
	       photos      add_content_sheet.dart, edit_store_screen.dart (gallery)
	     Only what is actually used is declared; App Store review asks about
	     permissions an app requests and never exercises.

	     English because that is what review reads. The strings are user-facing,
	     so localising them for tk/ru belongs in ios/Runner/<lang>.lproj/
	     InfoPlist.strings — not yet done. -->
	<key>NSCameraUsageDescription</key>
	<string>SeMay needs camera access so you can take photos and record videos for your stories and posts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SeMay needs microphone access to record sound with the videos you capture for your stories.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SeMay needs access to your photos so you can choose pictures and videos to share in posts, stories and chats.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Semay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>semay</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Declares that the app uses no NON-EXEMPT encryption. SeMay talks to its
	     own API over ordinary HTTPS and ships no cryptography of its own, which
	     is the standard exemption (Apple's question is about proprietary or
	     non-standard crypto, not TLS).

	     Without this key App Store Connect marks EVERY upload "Missing
	     Compliance" and the build cannot be attached to a version until someone
	     answers the questionnaire by hand — once per upload, forever. With it,
	     uploads go straight to usable.

	     Revisit this if the app ever ships its own encryption (local message
	     encryption, a bundled crypto library): the answer would become true and
	     the upload would then need real export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- semay://open/p|r|s/<id> — what the share page's "Open in SeMay" button
	     uses, and the only way into the app from a link on iOS until the
	     associated-domains entitlement exists (portal work: see
	     docs/09_DEPLOYMENT.md §5e; adding the entitlement before the App ID has
	     the capability breaks signing). FlutterDeepLinkingEnabled makes the
	     engine hand the URL to Flutter's router as a route — router.dart's
	     redirect turns it into the linked post/store. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.semay.semay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>semay</string>
			</array>
		</dict>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<!-- Lets a chat push (sent with content-available) wake the app briefly in
	     the background so firebaseMessagingBackgroundHandler can post the
	     delivered receipt — the sender's second grey check — before the user
	     ever opens the thread. Paired with Runner.entitlements' aps-environment. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
