<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches SplashScreen (lib/features/auth/splash_screen.dart)'s
         AppColors.backgroundPrimary light value + centered logo.png exactly,
         so the handoff from this native pre-Flutter-engine screen to the
         Dart-rendered one is seamless instead of visibly swapping from plain
         white to beige-with-logo (the default, un-customized template this
         used to be — that swap is what read as "two splash screens
         blinking"). -->
    <item android:drawable="@color/launch_background_color" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
