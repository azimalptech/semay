<?xml version="1.0" encoding="utf-8"?>
<!-- A fully transparent drawable used ONLY as the Android 12+ system splash
     icon (windowSplashScreenAnimatedIcon) so that mandated splash shows no
     logo — the logo appears exactly once, in the Dart SplashScreen. See
     values-v31/styles.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
