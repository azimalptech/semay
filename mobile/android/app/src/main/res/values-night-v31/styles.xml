<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode + Android 12+ (API 31). The `night` resource qualifier
         outranks `v31`, so on a dark-themed API 31+ device values-night/ would
         otherwise win over values-v31/ and re-introduce the mandated system
         splash icon. This most-specific bucket carries the same icon-blanking
         so the double-logo is gone in dark mode too. See values-v31/styles.xml
         for the full rationale. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
