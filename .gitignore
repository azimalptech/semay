node_modules/
dist/
.next/

# --- Flutter/Dart (mobile/) ---
build/
.dart_tool/
mobile/build/
mobile/ios/Pods/

# --- Runtime data (server/) — user uploads, logs, never committed ---
server/media/
server/logs/

# graphify (generated knowledge-graph output, not source)
graphify-out/

# Claude Code local/runtime state — may contain live credentials in
# permission-allow entries; nothing here is shared/team config
.claude/
deploy/staging/certs/
build-out/
